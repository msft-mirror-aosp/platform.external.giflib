package {
    default_applicable_licenses: ["external_giflib_license"],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "external_giflib_license",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "NOTICE",
    ],
}

cc_library_static {
    name: "libgif",

    sdk_version: "9",

    srcs: [
        "dgif_lib.c",
        "egif_lib.c",
        "gifalloc.c",
        "gif_err.c",
        "gif_hash.c",
        "quantize.c",
        "openbsd-reallocarray.c",
    ],

    cflags: [
        "-Werror",
        "-Wno-format",
        "-Wno-sign-compare",
        "-Wno-unused-parameter",

        // The giflib reallocarray() has special behavior for 0 arguments,
        // so we can't just use the bionic reallocarray() --
        // at least as long as our realloc() doesn't special case that --
        // and need to move the bionic reallocarray() polyfill out of the way,
        // or it will conflict with giflib's attempt to implement its own.
        "-Dreallocarray=bionic_reallocarray",
        "-include malloc.h",
        "-Ureallocarray",
    ],

    export_include_dirs: ["."],

    visibility: [
        "//frameworks/base/core/jni",
        "//frameworks/base/libs/hwui",
        "//packages/apps/Messaging/jni",
    ],
    product_available: true,
}
